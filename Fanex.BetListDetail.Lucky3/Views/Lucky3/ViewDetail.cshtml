@using Resources = Fanex.BetListDetail.Lucky3.Resources.Resource
@using Fanex.BetListDetail.Lucky3.ViewModels


@model Lucky3DetailViewModel

<table class="tblRpt tblRpt-bordered tblRpt-striped width-100per tablesorter tblRpt-hover tbl-betlist lucky3">
    <thead>
        <tr>
            <th>
                <div class="align-center">
                    @Resources.Number
                </div>
            </th>
            <th>
                <div class="col-normal">
                    @Resources.Hits
                </div>
            </th>
            <th>
                <div class="col-normal">
                    @Resources.Bets
                </div>
            </th>
            <th>
                <div class="col-normal">
                    @Resources.Prize
                </div>
            </th>
            <th>
                <div class="col-normal">
                    @Resources.Stake
                </div>
            </th>
            <th>
                <div class="col-normal">
                    @Resources.Winloss

                </div>
            </th>
            @if (Model.IsSuper)
            {
                <th>
                    <div class="col-normal">
                        @Resources.SuperComm
                    </div>
                </th>
            }
            @if (Model.IsSuper || Model.IsMaster)
            {
                <th>
                    <div class="col-normal">
                        @Resources.MasterComm
                    </div>
                </th>
            }
            @if (Model.IsAgent || Model.IsMaster || Model.IsSuper)
            {
                <th>
                    <div class="col-normal">
                        @Resources.AgentComm
                    </div>
                </th>
            }

            <th>
                <div class="col-normal">
                    @Resources.Status
                </div>
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Details.Any())
        {
            foreach (var ticket in Model.Details)
            {
                if (ticket.IsPrize)
                {
                    <tr>
                        <td class="align-left">
                            @foreach (var number in ticket.Numbers)
                            {
                                var color = "color" + number;
                                <div class="lottoBall @color">@number</div>
                            }
                        </td>
                        <td>@ticket.Hits</td>
                        <td>@Model.FormatBets(ticket.Bets)</td>
                        <td>@Model.FormatMoney(ticket.Prize)</td>
                        <td>@Model.FormatMoney(ticket.Stake)</td>
                        <td>@Model.FormatWinLost(ticket.Winlost)</td>
                        @if (Model.IsSuper)
                        {
                            <td>@Model.FormatDiscount(ticket.SuperDiscount) <br /> @Model.FormatMoney(ticket.SuperCommission)</td>
                        }
                        @if (Model.IsSuper || Model.IsMaster)
                        {
                            <td>@Model.FormatDiscount(ticket.MasterDiscount) <br /> @Model.FormatMoney(ticket.MasterCommission)</td>
                        }
                        @if (Model.IsAgent || Model.IsMaster || Model.IsSuper)
                        {
                            <td>@Model.FormatDiscount(ticket.AgentDiscount) <br /> @Model.FormatMoney(ticket.AgentCommission)</td>
                        }

                        <td class="align-center">@ticket.Status</td>
                    </tr>
                }
                else if (ticket.IsLosingCombination)
                {
                    <tr>
                        <td colspan="4">@Resources.TotalLost</td>
                        <td>@Model.FormatMoney(ticket.Stake)</td>
                        <td>@Model.FormatWinLost(ticket.Winlost.Value)</td>
                        @if (Model.IsSuper)
                        {
                            <td>@Model.FormatDiscount(ticket.SuperDiscount)<br /> @Model.FormatMoney(ticket.SuperCommission)</td>
                        }
                        @if (Model.IsSuper || Model.IsMaster)
                        {
                            <td>@Model.FormatDiscount(ticket.MasterDiscount)<br /> @Model.FormatMoney(ticket.MasterCommission)</td>
                        }

                        <td>@Model.FormatDiscount(ticket.AgentDiscount)<br /> @Model.FormatMoney(ticket.AgentCommission)</td>

                        <td class="align-left">@ticket.Status</td>
                    </tr>
                }
                else if (ticket.IsWinningShare)
                {
                    <tr>
                        <td colspan="5">@Resources.WinningShare</td>
                        <td>-</td>
                        @if (Model.IsSuper)
                        {
                            <td>@Model.FormatDiscount(ticket.SuperDiscount)<br /> @Model.FormatMoney(ticket.SuperCommission)</td>
                        }
                        @if (Model.IsSuper || Model.IsMaster)
                        {
                            <td>@Model.FormatDiscount(ticket.MasterDiscount)<br /> @Model.FormatMoney(ticket.MasterCommission)</td>
                        }

                        <td>@Model.FormatDiscount(ticket.AgentDiscount)<br /> @Model.FormatMoney(ticket.AgentCommission)</td>

                        <td></td>
                    </tr>
                }

            }

            <tr class="bl_footertotal">
                <td colspan="5" class="text-right">@Resources.Total</td>
                <td>@Model.FormatWinLost(Model.TotalWinlost)</td>
                @if (Model.IsSuper)
                {
                    <td>@Model.FormatMoney(Model.TotalSuperCommission)</td>
                }
                @if (Model.IsSuper || Model.IsMaster)
                {
                    <td>@Model.FormatMoney(Model.TotalMasterCommission)</td>
                }

                <td>@Model.FormatMoney(Model.TotalAgentCommission)</td>

                <td></td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="@Model.TotalColumns" class="text-center">@Resources.NoData</td>
            </tr>
        }
    </tbody>

</table>


