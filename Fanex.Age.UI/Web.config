<configuration>
  <configSections>
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" /><section name="CustomerSettingConfiguration" type="Fanex.CustomerSetting.Client40.Configurations.CustomerSettingConfiguration, Fanex.CustomerSetting.Client40" /><section name="SecurityCodeSection" type="Alpha.SecurityCode.Configurations.SecurityCodeSection, Alpha.SecurityCode" /></configSections>
    <system.web>
        <compilation debug="true" targetFramework="4.0" />
    <httpModules>
            <add name="Alpha.SecurityCodeHttpModule" type="Alpha.SecurityCode.HttpModules.SecurityCodeHttpModule, Alpha.SecurityCode" />
        </httpModules></system.web>

  <runtime>

    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">

      <dependentAssembly>

        <assemblyIdentity name="System.Core" publicKeyToken="b77a5c561934e089" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />

      </dependentAssembly>

      <dependentAssembly>

        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0" />

      </dependentAssembly>

    </assemblyBinding>

  </runtime>

<Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" /><Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider><CustomerSettingConfiguration System="1" ServiceUris="http://10.18.200.124:7577/api" CdnUris="http://10.18.200.124:7576" ClientLogCategory="DCS-Setting-Client-LOCAL" AccessDeniedAction="~/User/AccessDenied" SecretKey="U6BUFHtVcq5SPQcTl7tHLBG/LF6d5YVRKHrCHD9M+Vw=" /><SecurityCodeSection active="true" siteMain="site-main" currentSite="site-results" securityCodeVerifyUrl="Security/SecurityCode/VerifySecurityCode" forceChangeSecurityCodeUrl="Security/SecurityCode/ForceChangeSecurityCode" forceChangeSecurityCodeWithoutValidationUrl="Security/SecurityCode/ForceChangeSecurityCodeWithoutValidation"> 
        <ignoreUrl>
            <add url="/abc.aspx,/abc/def" isFullUrl="true" />
        </ignoreUrl>
    </SecurityCodeSection><system.webServer>
        <modules>
          <remove name="Alpha.SecurityCodeHttpModule" />
          <add name="Alpha.SecurityCodeHttpModule" type="Alpha.SecurityCode.HttpModules.SecurityCodeHttpModule, Alpha.SecurityCode" preCondition="managedHandler" />
        </modules>
      </system.webServer></configuration>
