<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Alpha.NetThrottling" type="Alpha.NetThrottling.NetThrottlingConfiguration, Alpha.NetThrottling" />
  </configSections>
  <Alpha.NetThrottling resolver="Alpha.NetThrottling.Resolvers.HttpErrorResolver, Alpha.NetThrottling" redisConfigurationOptionsKey="RedisConfigurationOptions">
    <keys>
      <add name="Home" path="~/" method="POST" maxRequests="2" throttleDuration="10" blockDuration="60" filter="Alpha.NetThrottling.WebTest.ThrottlingFilters.LoginFilter, Alpha.NetThrottling.WebTest" />
      <add name="Any" path="*" method="*" maxRequests="10" throttleDuration="30" blockDuration="30" filter="Alpha.NetThrottling.Filters.IpFilter" />
    </keys>
  </Alpha.NetThrottling>
  <appSettings>
    <add key="RedisConfigurationOptions" value="ha.nexdev.net:16389,Password=foo1@bared,Name=Alpha.NetThrottling.WebTest" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.0.0" newVersion="4.2.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>