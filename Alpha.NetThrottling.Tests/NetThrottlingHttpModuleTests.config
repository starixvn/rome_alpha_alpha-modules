<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="Alpha.NetThrottling" type="Alpha.NetThrottling.NetThrottlingConfiguration, Alpha.NetThrottling" />
  </configSections>
  <appSettings>
    <add key="RedisConfigurationOptions" value="ha.nexdev.net:16379,Password=foo1@bared,Name=Alpha.NetThrottling.WebTest" />
  </appSettings>
  <Alpha.NetThrottling resolver="Alpha.NetThrottling.Resolvers.HttpErrorResolver, Alpha.NetThrottling"
                       redisConfigurationOptionsKey="RedisConfigurationOptions">
    <keys>
      <add name="Login" path="" method="" maxRequests="1" throttleDuration="10" blockDuration="60" filter="" />
      <add name="Home" path="~/" method="POST" maxRequests="2" throttleDuration="10" blockDuration="60" filter="Alpha.NetThrottling.WebTest.ThrottlingFilters.LoginFilter, Alpha.NetThrottling.WebTest" />
      <add name="About" path="~/Home/About" method="*" maxRequests="10" throttleDuration="30" blockDuration="0" filter="Alpha.NetThrottling.Filters.IpFilter" />
    </keys>
  </Alpha.NetThrottling>
</configuration>