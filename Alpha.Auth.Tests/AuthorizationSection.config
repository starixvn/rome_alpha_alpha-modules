<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="AuthorizationSection" type="Alpha.Auth.Configurations.AuthorizationSection, Alpha.Auth" />
  </configSections>
  
  <AuthorizationSection
    fullpermission="[A],[B],[C],[D],[E],[G],[H]"
    custIdQueryStringParamNameMapping="custid,CustId,custId,targetCustId,id,cid,recommend,mrecommend,idagent,masterId,agentId,idAgent,idMaster,ibccustid,ACustID"
    custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
    ignoreUrls="SignIn.aspx,ProcessAdminLogin.ashx,ProcessAfterLogin.ashx,Captcha.ashx,ChartImg.axd,ReCheckin.ashx,SecurityCode,Header.aspx,Index.aspx"
    cachedExpireTime="50">
    <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
  -->
    <GroupPageAccess roleid="2" name="Agent">
      <PageAccesses>
        <add id="2.01.01" 
             permission="[A]" 
             mainfuncname="Add New Customer" 
             subfuncname="SC - Header page" 
             url="_MemberInfo/SearchAndCopy/Header.aspx" 
             ischeckbelonging="true" />

        <add id="2.01.02"
             permission="[A]"
             mainfuncname="Add New Customer"
             subfuncname="SC - Header page"
             url="_MemberInfo/SearchAndCopy/DoNotCheckBelonging.aspx"
             ischeckbelonging="false" />
      </PageAccesses>
    </GroupPageAccess>

    <GroupPageAccess roleid="3" name="Master">
      <PageAccesses>
        <add id="3.01.01" 
             permission="[A]" 
             mainfuncname="Add New Customer" 
             subfuncname="SC - Agent Info" 
             url="_MemberInfo/SearchAndCopy/Master/InfoAgent.aspx" 
             ischeckbelonging="true" />
      
       <add id="3.01.02" 
             permission="[A]" 
             mainfuncname="Group Header Line" 
             subfuncname="SC - Agent Info" 
             url="_MemberInfo/GroupHeadLine.aspx" 
             ischeckbelonging="true" 
             isviewedbygroupheadline="true" />
      
      <add id="3.01.03" 
             permission="[A]" 
             mainfuncname="Is Not Allow By Themselve" 
             subfuncname="SC - Agent Info" 
             url="IsNotAllowByThemselve.aspx" 
             ischeckbelonging="true" 
             isviewedbygroupheadline="true"
            isallowtodobythemselves="false"/>
      
      <add id="3.01.04" 
             permission="[A]" 
             mainfuncname="Is Allow By Themselve" 
             subfuncname="SC - Agent Info" 
             url="IsAllowByThemselve.aspx" 
             ischeckbelonging="true" 
             isviewedbygroupheadline="true"
            isallowtodobythemselves="true"/>
      </PageAccesses>
      
    </GroupPageAccess>

  </AuthorizationSection>
</configuration>

